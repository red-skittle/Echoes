# Afterlife Environment Configuration

# Database
# Default to SQLite for zero-friction local development, or configure PostgreSQL with pgvector:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/afterlife
DATABASE_URL=sqlite:///./afterlife.db

# Twitch API
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# OpenAI API (For transcription, embedding, and wiki knowledge extraction)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# App Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=afterlife-super-secret-key-change-in-production
DEBUG=True

